# AI Engine Configuration Example
# Copy to .env for local overrides (never commit .env)

# Provider selection: rules_only | ollama | gemini | auto
# Keep Gemini active for local verification; alternate providers remain available.
AI_PROVIDER=gemini

# Google Gemini Settings (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Ollama Settings (required if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Supabase Integration Settings (production policy source)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend-only key for Supabase brand memory. Never use a VITE_ prefix or expose to clients.
SUPABASE_SECRET_KEY=
# Postgres connection string for `make migrate` (dashboard > Connect). Backend-only; never in the frontend.
SUPABASE_DB_URL=
# Leave this unset to store app data in Supabase. Set a file path to use SQLite instead (tests, offline).
# ENGANO_DB_PATH=
# Backend-only shared key required by /api/brand-memory management routes.
ENGANO_MEMORY_API_KEY=
# Optional: file (default) | auto (Supabase only when SUPABASE_SECRET_KEY is set) | supabase
ENGANO_MEMORY_SOURCE=file

# Execution Settings
REQUEST_TIMEOUT_SECONDS=30.0
STRICT_MODE=false

# Discord Bot (Discord/)
DISCORD_BOT_TOKEN=
# Optional: sync slash commands to one server instantly while developing
DISCORD_GUILD_ID=
# Optional: web studio URL, enables the "Open in studio" button
ENGANO_STUDIO_URL=
# Brand that Discord drafts are checked against
ENGANO_BRAND_ID=nimbus_cloud
# Policy source: supabase (production) | fixture (data/brand_library, local testing only)
ENGANO_POLICY_SOURCE=fixture

# Human reviewer: gets drafts the engine is not sure about (WhatsApp number with country code; Discord user id)
ENGANO_REVIEWER_WHATSAPP=
ENGANO_REVIEWER_DISCORD_ID=
ENGANO_DEFAULT_COUNTRY_CODE=91

# Website checks run in a Docker container (`make renderer`). Leave empty to render in-process (needs Playwright's Chromium).
ENGANO_RENDERER_URL=
# Optional shared secret between the backend and the renderer container
ENGANO_RENDERER_TOKEN=

# Web Studio (Vite exposes only VITE_-prefixed variables to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# WhatsApp Cloud API (Backend/, webhook at /api/webhooks/whatsapp)
# Meta app > WhatsApp > API Setup: temporary token (24 h) or a system-user token
WHATSAPP_ACCESS_TOKEN=
# Meta app > App settings > Basic > App secret (verifies X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
# Used by `make webhook` to register the callback URL with Meta
WHATSAPP_APP_ID=
# Optional: the number review requests are sent from. Found automatically from the business account if blank.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Gmail review inbox (Gmail/): a dedicated Gmail account + app password
GMAIL_ADDRESS=
# Google Account > Security > 2-Step Verification > App passwords (not your normal password)
GMAIL_APP_PASSWORD=
# Who may use the inbox: addresses or @domains, comma-separated. Empty = anyone
GMAIL_ALLOWED_SENDERS=
GMAIL_POLL_SECONDS=15

# LinkedIn (LinkedIn/): developer app with "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/oauth/linkedin/callback
# Optional: post as a company page (needs the Community Management API product approved)
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=202608

# Hosting the web app elsewhere (Netlify) while the backend runs on this computer: allow that site to call it.
# Exact addresses (comma separated), and/or a pattern that also covers deploy previews:
# ENGANO_CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app
# ENGANO_CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.netlify\.app
# Reviews and website checks need a signed-in person by default; per-person limits per 10 minutes:
# ENGANO_REQUIRE_LOGIN=1
# ENGANO_REVIEW_LIMIT=40
# ENGANO_SITE_LIMIT=8
