# AI Engine Configuration Example
# Copy to .env for local overrides (never commit .env)

# Provider selection: rules_only | ollama | gemini | auto
AI_PROVIDER=rules_only

# Google Gemini Settings (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Settings (required if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Supabase Integration Settings (production policy source)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Execution Settings
REQUEST_TIMEOUT_SECONDS=30.0
STRICT_MODE=false

# Discord Bot (Discord/)
DISCORD_BOT_TOKEN=
# Optional: sync slash commands to one server instantly while developing
DISCORD_GUILD_ID=
# Optional: web studio URL, enables the "Open in studio" button
ENGANO_STUDIO_URL=
# Brand that Discord drafts are checked against
ENGANO_BRAND_ID=nimbus_cloud
# Policy source: supabase (production) | fixture (data/brand_library, local testing only)
ENGANO_POLICY_SOURCE=supabase

# Web Studio (Vite exposes only VITE_-prefixed variables to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# WhatsApp Cloud API (Backend/, webhook at /api/webhooks/whatsapp)
# Meta app > WhatsApp > API Setup: temporary token (24 h) or a system-user token
WHATSAPP_ACCESS_TOKEN=
# Meta app > App settings > Basic > App secret (verifies X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
